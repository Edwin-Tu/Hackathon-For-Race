# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3000
APP_NAME="Smart Care Shield"
APP_VERSION="2.0.0"
APP_URL=http://localhost:3000

# ==========================================
# Database Configuration
# ==========================================
# MySQL / Prisma (RDS MySQL)
DATABASE_URL="mysql://smart_care_app:YOUR_PASSWORD@smart-care-agent-db.c1e6cmcsyqsm.us-west-2.rds.amazonaws.com:3306/smart_care_agent"

# Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT=30000

# ==========================================
# AWS Configuration
# ==========================================
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=YOUR_ACCOUNT_ID
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN=YOUR_SESSION_TOKEN

# ==========================================
# AWS Bedrock (AI Model)
# ==========================================
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7

# ==========================================
# DynamoDB Configuration
# ==========================================
DYNAMODB_RESIDENTS_TABLE=smart_care_residents
DYNAMODB_EVENTS_TABLE=smart_care_events
DYNAMODB_USERS_TABLE=smart_care_users
DYNAMODB_AUDIT_TABLE=smart_care_audit_log

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_CHANGE_THIS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Session Configuration
SESSION_SECRET=YOUR_SESSION_SECRET_CHANGE_THIS
SESSION_MAX_AGE=604800000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Redis (Optional - for caching)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# Email Service (Optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Smart Care Shield <noreply@smartcare.com>"

# ==========================================
# AWS S3 (File Storage)
# ==========================================
S3_BUCKET_NAME=smart-care-uploads
S3_REGION=us-west-2
S3_PUBLIC_URL=https://your-bucket.s3.us-west-2.amazonaws.com

# ==========================================
# Monitoring & Logging
# ==========================================
# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# ==========================================
# Feature Flags
# ==========================================
FEATURE_AI_ENABLED=true
FEATURE_VOICE_ENABLED=true
FEATURE_VIDEO_UPLOAD=true
FEATURE_NOTIFICATIONS=true

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# Development Tools
# ==========================================
# Next.js Telemetry
NEXT_TELEMETRY_DISABLED=1

# Prisma Studio
PRISMA_STUDIO_PORT=5555

# ==========================================
# Testing
# ==========================================
TEST_DATABASE_URL="mysql://root:password@localhost:3306/smart_care_agent_test"

# ==========================================
# Notes
# ==========================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. Use strong, unique passwords and secrets
# 4. Rotate AWS credentials regularly
# 5. For production, use AWS Secrets Manager or similar service
