# AWS 認證
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-west-2

# S3 Buckets
AWS_S3_IMAGES_BUCKET=your-images-bucket
AWS_S3_VIDEOS_BUCKET=your-videos-bucket

# DynamoDB
AWS_DYNAMODB_TABLE_VIDEO_TASKS=VideoTasks

# Bedrock Model
AWS_BEDROCK_MODEL_ID=luma.ray-v2:0

# Next.js 公開變數
NEXT_PUBLIC_API_URL=/api
