// ============================================================================
// Smart Care Agent Database Schema v2.0
// Multi-Tenant, Multi-Role, AI Workspace Isolated Architecture
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS - Type Safety for Status and Role Fields
// ============================================================================

enum AccountType {
  ELDER
  FAMILY_GUARDIAN
  ORGANIZATION_MEMBER
  SYSTEM_ADMIN
}

enum OrganizationType {
  NURSING_HOME
  HOME_CARE_AGENCY
  DAY_CARE_CENTER
  ASSISTED_LIVING
  HOSPITAL_CARE_UNIT
  COMMUNITY_SERVICE
}

enum OrganizationRole {
  ORG_ADMIN
  CARE_MANAGER
  NURSE
  CAREGIVER
  SOCIAL_WORKER
  VIEWER
}

enum PersonaStatus {
  ACTIVE
  INACTIVE
  HOSPITALIZED
  TRANSFERRED
  DECEASED
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  ENDED
}

enum InteractionStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
}

enum ToolExecutionStatus {
  PROPOSED
  VALIDATING
  WAITING_CONFIRMATION
  APPROVED
  EXECUTING
  SUCCEEDED
  FAILED
  REJECTED
  EXPIRED
}

enum ConfirmationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum MemoryStatus {
  CANDIDATE
  COMMITTED
  ARCHIVED
  DELETED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  COMMITTED
}

enum ReminderStatus {
  SCHEDULED
  TRIGGERED
  COMPLETED
  CANCELLED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SummaryReviewStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMMITTED
  SENT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RelationshipType {
  FAMILY
  PRIMARY_CAREGIVER
  LEGAL_GUARDIAN
  MEDICAL_PROXY
  EMERGENCY_CONTACT
  NOTIFICATION_ONLY
}

enum ServiceType {
  AI_AGENT
  SCHEDULER
  ALERT_ENGINE
  SUMMARY_GENERATOR
  MEMORY_PROCESSOR
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum ActorType {
  USER
  AI
  SYSTEM
  SERVICE
}

// ============================================================================
// CORE TENANT & IDENTITY MODELS (Phase 1)
// ============================================================================

// Organization - 長照機構或照護服務組織
model Organization {
  organizationId     String           @id @default(cuid()) @map("organization_id")
  name               String
  organizationType   OrganizationType @map("organization_type")
  registrationNumber String?          @map("registration_number")
  contactEmail       String?          @map("contact_email")
  contactPhone       String?          @map("contact_phone")
  address            String?          @db.Text
  status             String           @default("active")
  timezone           String           @default("Asia/Taipei")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  // Relations
  members        OrganizationMember[]
  personas       OrganizationPersona[]
  interactions   Interaction[]
  careEvents     CareEvent[]
  reminders      Reminder[]
  careAlerts     CareAlert[]
  summaries      DailySummary[]
  audits         AuditLog[]
  memoCandidates AiMemoryCandidate[]
  summaryDrafts  AiSummaryDraft[]
  confirmations  ConfirmationRequest[]
  toolExecutions ToolExecution[]

  @@map("organizations")
}

// OrganizationMember - 使用者與長照機構的隸屬關係
model OrganizationMember {
  membershipId     String           @id @default(cuid()) @map("membership_id")
  organizationId   String           @map("organization_id")
  userId           String           @map("user_id")
  organizationRole OrganizationRole @map("organization_role")
  status           String           @default("active")
  startsAt         DateTime?        @map("starts_at")
  endsAt           DateTime?        @map("ends_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [organizationId])
  user         AppUser      @relation(fields: [userId], references: [userId])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_members")
}

// OrganizationPersona - 長者與長照機構的服務關係
model OrganizationPersona {
  relationshipId   String    @id @default(cuid()) @map("relationship_id")
  organizationId   String    @map("organization_id")
  personaId        String    @map("persona_id")
  relationshipType String    @default("primary_care") @map("relationship_type")
  status           String    @default("active")
  startsAt         DateTime? @map("starts_at")
  endsAt           DateTime? @map("ends_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [organizationId])
  persona      Persona      @relation(fields: [personaId], references: [personaId])

  @@unique([organizationId, personaId, status])
  @@index([personaId])
  @@index([organizationId, status])
  @@map("organization_personas")
}

// GuardianRelationship - 家屬、監護者與長者之間的授權關係
model GuardianRelationship {
  relationshipId      String           @id @default(cuid()) @map("relationship_id")
  userId              String           @map("user_id")
  personaId           String           @map("persona_id")
  relationshipType    RelationshipType @map("relationship_type")
  isLegalGuardian     Boolean          @default(false) @map("is_legal_guardian")
  canReadProfile      Boolean          @default(true) @map("can_read_profile")
  canReadHealthData   Boolean          @default(false) @map("can_read_health_data")
  canReadMedication   Boolean          @default(false) @map("can_read_medication")
  canReadConversation Boolean          @default(false) @map("can_read_conversation")
  canCreateCareEvent  Boolean          @default(false) @map("can_create_care_event")
  canUpdateCarePlan   Boolean          @default(false) @map("can_update_care_plan")
  canApproveAiAction  Boolean          @default(false) @map("can_approve_ai_action")
  canReceiveAlerts    Boolean          @default(true) @map("can_receive_alerts")
  startsAt            DateTime?        @map("starts_at")
  expiresAt           DateTime?        @map("expires_at")
  revokedAt           DateTime?        @map("revoked_at")
  revokedReason       String?          @map("revoked_reason") @db.Text
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  // Relations
  user    AppUser @relation(fields: [userId], references: [userId])
  persona Persona @relation(fields: [personaId], references: [personaId])

  @@unique([userId, personaId, relationshipType])
  @@index([personaId])
  @@index([userId])
  @@map("guardian_relationships")
}

// ============================================================================
// AI WORKSPACE MODELS (Phase 2)
// ============================================================================

// ServicePrincipal - 非人類系統身分（AI Agent、排程器等）
model ServicePrincipal {
  servicePrincipalId String      @id @default(cuid()) @map("service_principal_id")
  name               String      @unique
  serviceType        ServiceType @map("service_type")
  description        String?     @db.Text
  status             String      @default("active")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // Relations
  permissions    ServicePermission[]
  toolExecutions ToolExecution[]
  confirmations  ConfirmationRequest[]
  audits         AuditLog[]

  @@map("service_principals")
}

// ServicePermission - 控制系統服務可執行的操作
model ServicePermission {
  permissionId       String   @id @default(cuid()) @map("permission_id")
  servicePrincipalId String   @map("service_principal_id")
  resourceType       String   @map("resource_type")
  action             String
  scopeType          String?  @map("scope_type")
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  servicePrincipal ServicePrincipal @relation(fields: [servicePrincipalId], references: [servicePrincipalId])

  @@unique([servicePrincipalId, resourceType, action])
  @@index([servicePrincipalId])
  @@map("service_permissions")
}

// AiMemoryCandidate - AI 從對話推論出的候選記憶（AI Workspace）
model AiMemoryCandidate {
  candidateId         String             @id @default(cuid()) @map("candidate_id")
  organizationId      String             @map("organization_id")
  personaId           String             @map("persona_id")
  sourceInteractionId String?            @map("source_interaction_id")
  memoryType          String             @map("memory_type")
  memoryKey           String             @map("memory_key")
  candidateValue      Json               @map("candidate_value")
  confidence          Float?
  sensitivityLevel    DataClassification @default(INTERNAL) @map("sensitivity_level")
  reviewStatus        ReviewStatus       @default(PENDING) @map("review_status")
  reviewedByUserId    String?            @map("reviewed_by_user_id")
  reviewedAt          DateTime?          @map("reviewed_at")
  reviewNote          String?            @map("review_note") @db.Text
  expiresAt           DateTime?          @map("expires_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [organizationId])
  persona      Persona      @relation(fields: [personaId], references: [personaId])
  interaction  Interaction? @relation(fields: [sourceInteractionId], references: [interactionId])
  reviewedBy   AppUser?     @relation(fields: [reviewedByUserId], references: [userId])

  @@index([organizationId, personaId, reviewStatus])
  @@index([reviewStatus, createdAt])
  @@index([expiresAt])
  @@map("ai_memory_candidates")
}

// AiSummaryDraft - AI 產生的每日摘要或照護報告草稿（AI Workspace）
model AiSummaryDraft {
  draftId                 String              @id @default(cuid()) @map("draft_id")
  organizationId          String              @map("organization_id")
  personaId               String              @map("persona_id")
  summaryDate             DateTime            @map("summary_date") @db.Date
  draftText               String              @map("draft_text") @db.Text
  sourceEventIds          Json?               @map("source_event_ids")
  generationModel         String?             @map("generation_model")
  generationPromptVersion String?             @map("generation_prompt_version")
  reviewStatus            SummaryReviewStatus @default(DRAFT) @map("review_status")
  reviewedByUserId        String?             @map("reviewed_by_user_id")
  reviewedAt              DateTime?           @map("reviewed_at")
  reviewNote              String?             @map("review_note") @db.Text
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [organizationId])
  persona      Persona      @relation(fields: [personaId], references: [personaId])
  reviewedBy   AppUser?     @relation(fields: [reviewedByUserId], references: [userId])

  @@index([organizationId, personaId, summaryDate])
  @@index([reviewStatus, createdAt])
  @@map("ai_summary_drafts")
}

// ============================================================================
// CORE BUSINESS MODELS - Updated with Tenant Isolation (Phase 3)
// ============================================================================

// Persona - 住民主體（長者）
model Persona {
  personaId             String        @id @default(cuid()) @map("persona_id")
  primaryOrganizationId String?       @map("primary_organization_id")
  displayName           String        @map("display_name")
  memoryNamespace       String        @unique @map("memory_namespace")
  preferredLanguage     String        @default("zh-TW") @map("preferred_language")
  timezone              String        @default("Asia/Taipei")
  responseStyle         String?       @map("response_style")
  responseStyleConfig   Json?         @map("response_style_config")
  interests             Json?
  status                PersonaStatus @default(ACTIVE)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  // Relations
  organizationRelations OrganizationPersona[]
  guardianRelationships GuardianRelationship[]
  sessions              Session[]
  interactions          Interaction[]
  reminders             Reminder[]
  careEvents            CareEvent[]
  careAlerts            CareAlert[]
  audits                AuditLog[]
  preferences           PersonaPreference[]
  summaries             DailySummary[]
  userAccesses          UserPersonaAccess[]
  aiMemoryCandidates    AiMemoryCandidate[]
  aiSummaryDrafts       AiSummaryDraft[]

  @@index([primaryOrganizationId])
  @@index([status])
  @@map("personas")
}

// AppUser - 後台使用者（長者、家屬、機構人員、管理員）
model AppUser {
  userId       String      @id @default(cuid()) @map("user_id")
  username     String      @unique
  passwordHash String      @map("password_hash")
  displayName  String      @map("display_name")
  accountType  AccountType @map("account_type")
  email        String?
  phone        String?
  isActive     Boolean     @default(true) @map("is_active")
  lastLoginAt  DateTime?   @map("last_login_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  organizationMemberships OrganizationMember[]
  guardianRelationships   GuardianRelationship[]
  accesses                UserPersonaAccess[]
  sessions                AuthSession[]
  reviewedMemories        AiMemoryCandidate[]
  reviewedSummaries       AiSummaryDraft[]
  createdEvents           CareEvent[]            @relation("EventCreator")
  approvedEvents          CareEvent[]            @relation("EventApprover")
  createdReminders        Reminder[]             @relation("ReminderCreator")
  approvedReminders       Reminder[]             @relation("ReminderApprover")
  assignedAlerts          CareAlert[]            @relation("AlertAssignee")
  acknowledgedAlerts      CareAlert[]            @relation("AlertAcknowledger")
  resolvedAlerts          CareAlert[]            @relation("AlertResolver")

  @@map("app_users")
}

// UserPersonaAccess - 細粒度存取權限（取代原本的 read/write/admin）
model UserPersonaAccess {
  accessId            String    @id @default(cuid()) @map("access_id")
  organizationId      String    @map("organization_id")
  userId              String    @map("user_id")
  personaId           String    @map("persona_id")
  canReadProfile      Boolean   @default(true) @map("can_read_profile")
  canReadHealth       Boolean   @default(false) @map("can_read_health")
  canReadMedication   Boolean   @default(false) @map("can_read_medication")
  canReadConversation Boolean   @default(false) @map("can_read_conversation")
  canCreateEvent      Boolean   @default(false) @map("can_create_event")
  canUpdateEvent      Boolean   @default(false) @map("can_update_event")
  canManageReminder   Boolean   @default(false) @map("can_manage_reminder")
  canAcknowledgeAlert Boolean   @default(false) @map("can_acknowledge_alert")
  canApproveAiAction  Boolean   @default(false) @map("can_approve_ai_action")
  grantedByUserId     String?   @map("granted_by_user_id")
  startsAt            DateTime? @map("starts_at")
  expiresAt           DateTime? @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  user    AppUser @relation(fields: [userId], references: [userId])
  persona Persona @relation(fields: [personaId], references: [personaId])

  @@unique([userId, personaId, organizationId])
  @@index([organizationId, personaId])
  @@index([userId])
  @@map("user_persona_access")
}

// Session - 工作階段
model Session {
  sessionId        String        @id @default(cuid()) @map("session_id")
  personaId        String?       @map("persona_id")
  sessionStatus    SessionStatus @default(ACTIVE) @map("session_status")
  clientType       String        @map("client_type")
  clientIdentifier String?       @map("client_identifier")
  startedAt        DateTime      @default(now()) @map("started_at")
  lastActiveAt     DateTime      @updatedAt @map("last_active_at")
  expiresAt        DateTime?     @map("expires_at")
  endedAt          DateTime?     @map("ended_at")
  endReason        String?       @map("end_reason")

  // Relations
  persona              Persona?              @relation(fields: [personaId], references: [personaId])
  interactions         Interaction[]
  confirmationRequests ConfirmationRequest[]

  @@index([personaId, sessionStatus])
  @@map("sessions")
}

// Interaction - 互動記錄
model Interaction {
  interactionId      String             @id @default(cuid()) @map("interaction_id")
  requestId          String             @unique @map("request_id")
  organizationId     String             @map("organization_id")
  sessionId          String             @map("session_id")
  personaId          String             @map("persona_id")
  actorUserId        String?            @map("actor_user_id")
  servicePrincipalId String?            @map("service_principal_id")
  inputType          String             @map("input_type")
  transcript         String?            @db.Text
  normalizedText     String?            @map("normalized_text") @db.Text
  asrLanguage        String?            @map("asr_language")
  asrConfidence      Float?             @map("asr_confidence")
  asrMetadata        Json?              @map("asr_metadata")
  agentResponse      String?            @map("agent_response") @db.Text
  interactionStatus  InteractionStatus  @default(RECEIVED) @map("interaction_status")
  dataClassification DataClassification @default(INTERNAL) @map("data_classification")
  errorCode          String?            @map("error_code")
  errorMessage       String?            @map("error_message")
  startedAt          DateTime           @default(now()) @map("started_at")
  completedAt        DateTime?          @map("completed_at")

  // Relations
  organization       Organization        @relation(fields: [organizationId], references: [organizationId])
  session            Session             @relation(fields: [sessionId], references: [sessionId])
  persona            Persona             @relation(fields: [personaId], references: [personaId])
  toolExecutions     ToolExecution[]
  reminders          Reminder[]
  careEvents         CareEvent[]
  summaries          DailySummaryEvent[]
  aiMemoryCandidates AiMemoryCandidate[]

  @@index([organizationId, personaId, startedAt])
  @@index([sessionId])
  @@map("interactions")
}

// ToolExecution - 工具執行記錄（AI 與正式系統的橋接）
model ToolExecution {
  toolExecutionId    String              @id @default(cuid()) @map("tool_execution_id")
  requestId          String              @map("request_id")
  organizationId     String              @map("organization_id")
  sessionId          String              @map("session_id")
  personaId          String              @map("persona_id")
  interactionId      String?             @map("interaction_id")
  servicePrincipalId String?             @map("service_principal_id")
  toolName           String              @map("tool_name")
  toolArguments      Json                @map("tool_arguments")
  toolStatus         ToolExecutionStatus @default(PROPOSED) @map("tool_status")
  riskLevel          RiskLevel?          @map("risk_level")
  idempotencyKey     String?             @unique @map("idempotency_key")
  recordType         String?             @map("record_type")
  recordId           String?             @map("record_id")
  resultPayload      Json?               @map("result_payload")
  errorCode          String?             @map("error_code")
  errorMessage       String?             @map("error_message")
  startedAt          DateTime            @default(now()) @map("started_at")
  finishedAt         DateTime?           @map("finished_at")

  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [organizationId])
  interaction      Interaction?      @relation(fields: [interactionId], references: [interactionId])
  servicePrincipal ServicePrincipal? @relation(fields: [servicePrincipalId], references: [servicePrincipalId])

  @@index([organizationId, personaId, toolStatus])
  @@index([toolStatus, startedAt])
  @@map("tool_executions")
}

// PersonaPreference - 住民偏好（正式資料，只儲存已核准記憶）
model PersonaPreference {
  preferenceId        String   @id @default(cuid()) @map("preference_id")
  personaId           String   @map("persona_id")
  preferenceKey       String   @map("preference_key")
  preferenceValue     Json     @map("preference_value")
  version             Int      @default(1)
  isActive            Boolean  @default(true) @map("is_active")
  sourceType          String   @map("source_type")
  sourceInteractionId String?  @map("source_interaction_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  persona Persona @relation(fields: [personaId], references: [personaId])

  @@unique([personaId, preferenceKey, version])
  @@index([personaId, isActive])
  @@map("persona_preferences")
}

// CareEvent - 照護事件（正式資料）
model CareEvent {
  eventId          String       @id @default(cuid()) @map("event_id")
  organizationId   String       @map("organization_id")
  personaId        String       @map("persona_id")
  sessionId        String?      @map("session_id")
  interactionId    String?      @map("interaction_id")
  toolExecutionId  String?      @map("tool_execution_id")
  eventType        String       @map("event_type")
  content          String       @db.Text
  eventTime        DateTime?    @map("event_time")
  eventEndTime     DateTime?    @map("event_end_time")
  confidence       Float?
  sourceText       String?      @map("source_text") @db.Text
  memoryStatus     MemoryStatus @default(CANDIDATE) @map("memory_status")
  riskLevel        RiskLevel?   @map("risk_level")
  createdByType    ActorType?   @map("created_by_type")
  createdById      String?      @map("created_by_id")
  idempotencyKey   String?      @unique @map("idempotency_key")
  approvedByUserId String?      @map("approved_by_user_id")
  committedAt      DateTime?    @map("committed_at")
  approvedAt       DateTime?    @map("approved_at")
  archivedAt       DateTime?    @map("archived_at")
  deletedAt        DateTime?    @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  // Relations
  organization Organization    @relation(fields: [organizationId], references: [organizationId])
  persona      Persona         @relation(fields: [personaId], references: [personaId])
  interaction  Interaction?    @relation(fields: [interactionId], references: [interactionId])
  createdBy    AppUser?        @relation("EventCreator", fields: [createdById], references: [userId])
  approvedBy   AppUser?        @relation("EventApprover", fields: [approvedByUserId], references: [userId])
  revisions    EventRevision[]

  @@index([organizationId, personaId, eventTime])
  @@index([memoryStatus])
  @@map("care_events")
}

// EventRevision - 事件修訂歷史
model EventRevision {
  revisionId     String   @id @default(cuid()) @map("revision_id")
  eventId        String   @map("event_id")
  revisionNumber Int      @map("revision_number")
  oldData        Json?    @map("old_data")
  newData        Json?    @map("new_data")
  changeReason   String?  @map("change_reason")
  changedBy      String?  @map("changed_by")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  event CareEvent @relation(fields: [eventId], references: [eventId])

  @@unique([eventId, revisionNumber])
  @@map("event_revisions")
}

// Reminder - 提醒排程（正式資料）
model Reminder {
  reminderId         String              @id @default(cuid()) @map("reminder_id")
  organizationId     String              @map("organization_id")
  personaId          String              @map("persona_id")
  interactionId      String?             @map("interaction_id")
  title              String
  description        String?             @db.Text
  scheduledAt        DateTime            @map("scheduled_at")
  timezone           String              @default("Asia/Taipei")
  recurrenceRule     String?             @map("recurrence_rule")
  importance         String              @default("normal")
  reminderStatus     ReminderStatus      @default(SCHEDULED) @map("reminder_status")
  confirmationStatus ConfirmationStatus? @default(PENDING) @map("confirmation_status")
  riskLevel          RiskLevel?          @map("risk_level")
  createdByType      ActorType?          @map("created_by_type")
  createdById        String?             @map("created_by_id")
  approvedByUserId   String?             @map("approved_by_user_id")
  idempotencyKey     String?             @unique @map("idempotency_key")
  triggeredAt        DateTime?           @map("triggered_at")
  completedAt        DateTime?           @map("completed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [organizationId])
  persona      Persona      @relation(fields: [personaId], references: [personaId])
  interaction  Interaction? @relation(fields: [interactionId], references: [interactionId])
  createdBy    AppUser?     @relation("ReminderCreator", fields: [createdById], references: [userId])
  approvedBy   AppUser?     @relation("ReminderApprover", fields: [approvedByUserId], references: [userId])

  @@index([organizationId, personaId, scheduledAt])
  @@index([reminderStatus])
  @@map("reminders")
}

// ConfirmationRequest - 確認請求（AI 與使用者互動）
model ConfirmationRequest {
  confirmationId       String             @id @default(cuid()) @map("confirmation_id")
  organizationId       String             @map("organization_id")
  sessionId            String             @map("session_id")
  personaId            String             @map("persona_id")
  requestedByServiceId String?            @map("requested_by_service_id")
  targetType           String             @map("target_type")
  targetId             String             @map("target_id")
  confirmationQuestion String             @map("confirmation_question")
  requiredPermission   String?            @map("required_permission")
  confirmationStatus   ConfirmationStatus @default(PENDING) @map("confirmation_status")
  confirmedByUserId    String?            @map("confirmed_by_user_id")
  confirmedAt          DateTime?          @map("confirmed_at")
  expiresAt            DateTime?          @map("expires_at")
  responseText         String?            @map("response_text")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  organization       Organization      @relation(fields: [organizationId], references: [organizationId])
  session            Session           @relation(fields: [sessionId], references: [sessionId])
  requestedByService ServicePrincipal? @relation(fields: [requestedByServiceId], references: [servicePrincipalId])

  @@index([organizationId, personaId, confirmationStatus])
  @@index([confirmationStatus, expiresAt])
  @@map("confirmation_requests")
}

// DailySummary - 每日摘要（正式資料，只儲存已核准版本）
model DailySummary {
  summaryId       String              @id @default(cuid()) @map("summary_id")
  organizationId  String              @map("organization_id")
  personaId       String              @map("persona_id")
  summaryDate     DateTime            @map("summary_date") @db.Date
  summaryText     String              @map("summary_text") @db.Text
  summaryVersion  Int                 @default(1) @map("summary_version")
  reviewStatus    SummaryReviewStatus @default(UNDER_REVIEW) @map("review_status")
  generationModel String?             @map("generation_model")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  organization Organization        @relation(fields: [organizationId], references: [organizationId])
  persona      Persona             @relation(fields: [personaId], references: [personaId])
  events       DailySummaryEvent[]

  @@index([organizationId, personaId, summaryDate])
  @@map("daily_summaries")
}

// DailySummaryEvent - 摘要事件關聯
model DailySummaryEvent {
  summaryId      String   @map("summary_id")
  eventId        String   @map("event_id")
  sourceOrder    Int      @map("source_order")
  includedReason String?  @map("included_reason")
  interactionId  String?  @map("interaction_id")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  summary     DailySummary @relation(fields: [summaryId], references: [summaryId])
  interaction Interaction? @relation(fields: [interactionId], references: [interactionId])

  @@id([summaryId, eventId])
  @@map("daily_summary_events")
}

// CareAlert - 照護警示（正式資料）
model CareAlert {
  alertId              String        @id @default(cuid()) @map("alert_id")
  organizationId       String        @map("organization_id")
  personaId            String        @map("persona_id")
  alertType            String        @map("alert_type")
  severity             AlertSeverity
  sourceText           String?       @map("source_text") @db.Text
  alertStatus          AlertStatus   @default(OPEN) @map("alert_status")
  assignedToUserId     String?       @map("assigned_to_user_id")
  acknowledgedByUserId String?       @map("acknowledged_by_user_id")
  resolvedByUserId     String?       @map("resolved_by_user_id")
  idempotencyKey       String?       @unique @map("idempotency_key")
  acknowledgedAt       DateTime?     @map("acknowledged_at")
  resolvedAt           DateTime?     @map("resolved_at")
  resolutionNote       String?       @map("resolution_note") @db.Text
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [organizationId])
  persona        Persona      @relation(fields: [personaId], references: [personaId])
  assignedTo     AppUser?     @relation("AlertAssignee", fields: [assignedToUserId], references: [userId])
  acknowledgedBy AppUser?     @relation("AlertAcknowledger", fields: [acknowledgedByUserId], references: [userId])
  resolvedBy     AppUser?     @relation("AlertResolver", fields: [resolvedByUserId], references: [userId])

  @@index([organizationId, personaId, alertStatus])
  @@index([alertStatus, severity])
  @@map("care_alerts")
}

// AuditLog - 稽核日誌（不可由 AI 或一般 API 修改）
model AuditLog {
  auditId            String     @id @default(cuid()) @map("audit_id")
  requestId          String     @map("request_id")
  organizationId     String?    @map("organization_id")
  personaId          String?    @map("persona_id")
  actorType          ActorType  @map("actor_type")
  actorId            String?    @map("actor_id")
  servicePrincipalId String?    @map("service_principal_id")
  actionType         String     @map("action_type")
  resourceType       String     @map("resource_type")
  resourceId         String?    @map("resource_id")
  toolName           String?    @map("tool_name")
  riskLevel          RiskLevel? @map("risk_level")
  result             String
  reason             String?    @db.Text
  metadata           Json?
  createdAt          DateTime   @default(now()) @map("created_at")

  // Relations
  organization     Organization?     @relation(fields: [organizationId], references: [organizationId])
  persona          Persona?          @relation(fields: [personaId], references: [personaId])
  servicePrincipal ServicePrincipal? @relation(fields: [servicePrincipalId], references: [servicePrincipalId])

  @@index([organizationId, personaId, createdAt])
  @@index([actorType, actorId])
  @@map("audit_logs")
}

// AuthSession - 登入會話（AI 完全不可存取）
model AuthSession {
  sessionTokenHash String    @id @map("session_token_hash")
  userId           String    @map("user_id")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Relations
  user AppUser @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
