generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model app_users {
  user_id             String                @id
  username            String                @unique
  password_hash       String
  display_name        String
  role                String                @default("caregiver")
  persona_id          String?
  is_active           Boolean               @default(true)
  last_login_at       DateTime?
  created_at          DateTime              @default(now())
  updated_at          DateTime
  auth_sessions       auth_sessions[]
  user_persona_access user_persona_access[]
}

model audit_logs {
  audit_id      String    @id
  request_id    String
  actor_type    String
  action_type   String
  resource_type String
  resource_id   String?
  tool_name     String?
  risk_level    String?
  result        String
  reason        String?   @db.Text
  metadata      Json?
  persona_id    String?
  created_at    DateTime  @default(now())
  personas      personas? @relation(fields: [persona_id], references: [persona_id])

  @@index([persona_id], map: "audit_logs_persona_id_fkey")
}

model auth_sessions {
  session_token_hash String    @id
  user_id            String
  expires_at         DateTime
  revoked_at         DateTime?
  last_seen_at       DateTime?
  created_at         DateTime  @default(now())
  app_users          app_users @relation(fields: [user_id], references: [user_id])

  @@index([user_id], map: "auth_sessions_user_id_fkey")
}

model care_alerts {
  alert_id        String   @id
  persona_id      String
  alert_type      String
  severity        String
  source_text     String?  @db.Text
  alert_status    String   @default("open")
  assigned_to     String?
  idempotency_key String?  @unique
  resolution_note String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime
  personas        personas @relation(fields: [persona_id], references: [persona_id])

  @@index([persona_id], map: "care_alerts_persona_id_fkey")
}

model care_events {
  event_id          String            @id
  persona_id        String
  session_id        String?
  interaction_id    String?
  tool_execution_id String?
  event_type        String
  content           String            @db.Text
  event_time        DateTime?
  event_end_time    DateTime?
  confidence        Float?
  source_text       String?           @db.Text
  memory_status     String            @default("candidate")
  risk_level        String?
  created_by_type   String?
  created_by_id     String?
  committed_at      DateTime?
  archived_at       DateTime?
  deleted_at        DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime
  interactions      interactions?     @relation(fields: [interaction_id], references: [interaction_id])
  personas          personas          @relation(fields: [persona_id], references: [persona_id])
  event_revisions   event_revisions[]

  @@index([interaction_id], map: "care_events_interaction_id_fkey")
  @@index([persona_id], map: "care_events_persona_id_fkey")
}

model confirmation_requests {
  confirmation_id       String    @id
  session_id            String
  target_type           String
  target_id             String
  confirmation_question String
  confirmation_status   String    @default("pending")
  expires_at            DateTime?
  response_text         String?
  created_at            DateTime  @default(now())
  updated_at            DateTime
  sessions              sessions  @relation(fields: [session_id], references: [session_id])

  @@index([session_id], map: "confirmation_requests_session_id_fkey")
}

model daily_summaries {
  summary_id           String                 @id
  persona_id           String
  summary_date         DateTime
  summary_text         String                 @db.Text
  summary_version      Int                    @default(1)
  review_status        String                 @default("draft")
  generation_model     String?
  created_at           DateTime               @default(now())
  updated_at           DateTime
  personas             personas               @relation(fields: [persona_id], references: [persona_id])
  daily_summary_events daily_summary_events[]

  @@index([persona_id], map: "daily_summaries_persona_id_fkey")
}

model daily_summary_events {
  summary_id      String
  event_id        String
  source_order    Int
  included_reason String?
  interaction_id  String?
  created_at      DateTime        @default(now())
  interactions    interactions?   @relation(fields: [interaction_id], references: [interaction_id])
  daily_summaries daily_summaries @relation(fields: [summary_id], references: [summary_id])

  @@id([summary_id, event_id])
  @@index([interaction_id], map: "daily_summary_events_interaction_id_fkey")
}

model event_revisions {
  revision_id     String      @id
  event_id        String
  revision_number Int
  old_data        Json?
  new_data        Json?
  change_reason   String?
  changed_by      String?
  created_at      DateTime    @default(now())
  care_events     care_events @relation(fields: [event_id], references: [event_id])

  @@unique([event_id, revision_number])
}

model interactions {
  interaction_id       String                 @id
  request_id           String                 @unique
  session_id           String
  persona_id           String
  input_type           String
  transcript           String?                @db.Text
  normalized_text      String?                @db.Text
  asr_language         String?
  asr_confidence       Float?
  asr_metadata         Json?
  agent_response       String?                @db.Text
  interaction_status   String                 @default("received")
  error_code           String?
  error_message        String?
  started_at           DateTime               @default(now())
  completed_at         DateTime?
  care_events          care_events[]
  daily_summary_events daily_summary_events[]
  personas             personas               @relation(fields: [persona_id], references: [persona_id])
  sessions             sessions               @relation(fields: [session_id], references: [session_id])
  reminders            reminders[]
  tool_executions      tool_executions[]

  @@index([persona_id], map: "interactions_persona_id_fkey")
  @@index([session_id], map: "interactions_session_id_fkey")
}

model persona_preferences {
  preference_id         String   @id
  persona_id            String
  preference_key        String
  preference_value      Json
  version               Int      @default(1)
  is_active             Boolean  @default(true)
  source_type           String
  source_interaction_id String?
  created_at            DateTime @default(now())
  updated_at            DateTime
  personas              personas @relation(fields: [persona_id], references: [persona_id])

  @@unique([persona_id, preference_key, version])
}

model personas {
  persona_id            String                @id
  display_name          String
  memory_namespace      String                @unique
  preferred_language    String                @default("zh-TW")
  response_style        String?
  response_style_config Json?
  interests             Json?
  status                String                @default("active")
  created_at            DateTime              @default(now())
  updated_at            DateTime
  deleted_at            DateTime?
  audit_logs            audit_logs[]
  care_alerts           care_alerts[]
  care_events           care_events[]
  daily_summaries       daily_summaries[]
  interactions          interactions[]
  persona_preferences   persona_preferences[]
  reminders             reminders[]
  sessions              sessions[]
}

model reminders {
  reminder_id         String        @id
  persona_id          String
  interaction_id      String?
  title               String
  description         String?       @db.Text
  scheduled_at        DateTime
  importance          String        @default("normal")
  reminder_status     String        @default("scheduled")
  confirmation_status String?       @default("pending")
  idempotency_key     String?       @unique
  triggered_at        DateTime?
  completed_at        DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime
  interactions        interactions? @relation(fields: [interaction_id], references: [interaction_id])
  personas            personas      @relation(fields: [persona_id], references: [persona_id])

  @@index([interaction_id], map: "reminders_interaction_id_fkey")
  @@index([persona_id], map: "reminders_persona_id_fkey")
}

model sessions {
  session_id            String                  @id
  persona_id            String?
  session_status        String                  @default("active")
  client_type           String
  client_identifier     String?
  started_at            DateTime                @default(now())
  last_active_at        DateTime
  expires_at            DateTime?
  ended_at              DateTime?
  end_reason            String?
  confirmation_requests confirmation_requests[]
  interactions          interactions[]
  personas              personas?               @relation(fields: [persona_id], references: [persona_id])

  @@index([persona_id], map: "sessions_persona_id_fkey")
}

model tool_executions {
  tool_execution_id String        @id
  request_id        String
  session_id        String
  persona_id        String
  interaction_id    String?
  tool_name         String
  tool_arguments    Json
  tool_status       String        @default("proposed")
  risk_level        String?
  idempotency_key   String?       @unique
  record_type       String?
  record_id         String?
  result_payload    Json?
  error_code        String?
  error_message     String?
  started_at        DateTime      @default(now())
  finished_at       DateTime?
  interactions      interactions? @relation(fields: [interaction_id], references: [interaction_id])

  @@index([interaction_id], map: "tool_executions_interaction_id_fkey")
}

model user_persona_access {
  access_id    String    @id
  user_id      String
  persona_id   String
  access_level String    @default("read")
  created_at   DateTime  @default(now())
  app_users    app_users @relation(fields: [user_id], references: [user_id])

  @@unique([user_id, persona_id])
}
